// X(opcode, name, str, class, format, argCount, src1, src2, src3)
#define EncodeOpcode(opcode) ((static_cast<uint32_t>(opcode) << 24) & 0xFF000000)
#define CTRL(opcode, name) X((EncodeOpcode(opcode)), name, #name, Base, CTRL, 1, UnusedField, UnusedField, UnusedField)
CTRL(0x08, b)
CTRL(0x09, call)
CTRL(0x0a, ret)
CTRL(0x0b, bal)
CTRL(0x10, bno)
CTRL(0x11, bg)
CTRL(0x12, be)
CTRL(0x13, bge)
CTRL(0x14, bl)
CTRL(0x15, bne)
CTRL(0x16, ble)
CTRL(0x17, bo)
CTRL(0x18, faultno)
CTRL(0x19, faultg)
CTRL(0x1a, faulte)
CTRL(0x1b, faultge)
CTRL(0x1c, faultl)
CTRL(0x1d, faultne)
CTRL(0x1e, faultle)
CTRL(0x1f, faulto)
#undef CTRL
#define BaseCOBR(opcode, name, count, src1, src2) X((EncodeOpcode(opcode)), name, #name, Base, COBR, count, src1, src2, UnusedField)
#define TestOperation(opcode, name) BaseCOBR(opcode, name, 1, R, UnusedField)
#define NormalCOBR(opcode, name) BaseCOBR(opcode, name, 3, RL, RS)
TestOperation(0x20, testno)
TestOperation(0x21, testg)
TestOperation(0x22, teste)
TestOperation(0x23, testge)
TestOperation(0x24, testl)
TestOperation(0x25, testne)
TestOperation(0x26, testle)
TestOperation(0x27, testo)
NormalCOBR(0x30, bbc)
NormalCOBR(0x31, cmpobg)
NormalCOBR(0x32, cmpobe)
NormalCOBR(0x33, cmpobge)
NormalCOBR(0x34, cmpobl)
NormalCOBR(0x35, cmpobne)
NormalCOBR(0x36, cmpoble)
NormalCOBR(0x37, bbs)
NormalCOBR(0x38, cmpibno)
NormalCOBR(0x39, cmpibg)
NormalCOBR(0x3a, cmpibe)
NormalCOBR(0x3b, cmpibge)
NormalCOBR(0x3c, cmpibl)
NormalCOBR(0x3d, cmpibne)
NormalCOBR(0x3e, cmpible)
NormalCOBR(0x3f, cmpibo)
#undef NormalCOBR
#undef TestOperation
#undef BaseCOBR

#define MEM(opcode, name, size, count, src1, src2) X((EncodeOpcode(opcode)), name, #name, Base, MEM ## size, count, src1, src2, UnusedField)
MEM(0x80, ldob, 1, 2, M, R)
MEM(0x82, stob, 1, 2, R, M)
MEM(0x84, bx, 1, 1, M, UnusedField)
MEM(0x85, balx, 1, 3, M, R)
MEM(0x86, callx, 1, 1, M, UnusedField)
MEM(0x88, ldos, 2, 2, M, R)
MEM(0x8a, stos, 2, 2, R, M)
MEM(0x8c, lda, 1, 2, M, R)

MEM(0x90, ld, 4, 2, M, R)
MEM(0x92, st, 4, 2, R, M)
MEM(0x98, ldl, 8, 2, M, R2)
MEM(0x9a, stl, 8, 2, R2, M)
MEM(0xa0, ldt, 12, 2, M, R4)
MEM(0xa2, stt, 12, 2, R4, M)

MEM(0xb0, ldq, 16, 2, M, R4)
MEM(0xb2, stq, 16, 2, R4, M)

MEM(0xc0, ldib, 1, 2, M, R)
MEM(0xc2, stib, 1, 2, R, M)
MEM(0xc8, ldis, 2, 2, M, R)
MEM(0xca, stis, 2, 2, R, M)
#undef MEM

#undef EncodeOpcode
#endif

