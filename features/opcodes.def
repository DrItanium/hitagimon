// X(opcode, name, str, class, format, argCount, src1, src2, src3)
#define EncodeOpcode(opcode) ((static_cast<uint32_t>(opcode) << 24) & 0xFF000000)
#define CTRL(opcode, name) X((EncodeOpcode(opcode)), name, #name, Base, CTRL, 1, UnusedField, UnusedField, UnusedField)
CTRL(0x08, b)
CTRL(0x09, call)
CTRL(0x0a, ret)
CTRL(0x0b, bal)
CTRL(0x10, bno)
CTRL(0x11, bg)
CTRL(0x12, be)
CTRL(0x13, bge)
CTRL(0x14, bl)
CTRL(0x15, bne)
CTRL(0x16, ble)
CTRL(0x17, bo)
CTRL(0x18, faultno)
CTRL(0x19, faultg)
CTRL(0x1a, faulte)
CTRL(0x1b, faultge)
CTRL(0x1c, faultl)
CTRL(0x1d, faultne)
CTRL(0x1e, faultle)
CTRL(0x1f, faulto)
#undef CTRL
#define BaseCOBR(opcode, name, count, src1, src2) X((EncodeOpcode(opcode)), name, #name, Base, COBR, count, src1, src2, UnusedField)
#define TestOperation(opcode, name) BaseCOBR(opcode, name, 1, R, UnusedField)
#define NormalCOBR(opcode, name) BaseCOBR(opcode, name, 3, RL, RS)
TestOperation(0x20, testno)
TestOperation(0x21, testg)
TestOperation(0x22, teste)
TestOperation(0x23, testge)
TestOperation(0x24, testl)
TestOperation(0x25, testne)
TestOperation(0x26, testle)
TestOperation(0x27, testo)
NormalCOBR(0x30, bbc)
NormalCOBR(0x31, cmpobg)
NormalCOBR(0x32, cmpobe)
NormalCOBR(0x33, cmpobge)
NormalCOBR(0x34, cmpobl)
NormalCOBR(0x35, cmpobne)
NormalCOBR(0x36, cmpoble)
NormalCOBR(0x37, bbs)
NormalCOBR(0x38, cmpibno)
NormalCOBR(0x39, cmpibg)
NormalCOBR(0x3a, cmpibe)
NormalCOBR(0x3b, cmpibge)
NormalCOBR(0x3c, cmpibl)
NormalCOBR(0x3d, cmpibne)
NormalCOBR(0x3e, cmpible)
NormalCOBR(0x3f, cmpibo)
#undef NormalCOBR
#undef TestOperation
#undef BaseCOBR

#define MEM(opcode, name, size, count, src1, src2) X((EncodeOpcode(opcode)), name, #name, Base, MEM ## size, count, src1, src2, UnusedField)
MEM(0x80, ldob, 1, 2, M, R)
MEM(0x82, stob, 1, 2, R, M)
MEM(0x84, bx, 1, 1, M, UnusedField)
MEM(0x85, balx, 1, 3, M, R)
MEM(0x86, callx, 1, 1, M, UnusedField)
MEM(0x88, ldos, 2, 2, M, R)
MEM(0x8a, stos, 2, 2, R, M)
MEM(0x8c, lda, 1, 2, M, R)

MEM(0x90, ld, 4, 2, M, R)
MEM(0x92, st, 4, 2, R, M)
MEM(0x98, ldl, 8, 2, M, R2)
MEM(0x9a, stl, 8, 2, R2, M)
MEM(0xa0, ldt, 12, 2, M, R4)
MEM(0xa2, stt, 12, 2, R4, M)

MEM(0xb0, ldq, 16, 2, M, R4)
MEM(0xb2, stq, 16, 2, R4, M)

MEM(0xc0, ldib, 1, 2, M, R)
MEM(0xc2, stib, 1, 2, R, M)
MEM(0xc8, ldis, 2, 2, M, R)
MEM(0xca, stis, 2, 2, R, M)
#undef MEM
#define EncodeREGOpcode(v) (((v & 0xff0) << 20) | ((v & 0xf) << 7))
#define CoreREG(opcode, name, class, count, src1, src2, srcDest) X((EncodeREGOpcode(opcode)), name, #name, class, REG, count, src1, src2, srcDest)
#define BaseREG(opcode, name, count, src1, src2, srcDest) CoreREG(opcode, name, Base, count, src1, src2, srcDest)
#define BaseREG3(opcode, name) BaseREG(opcode, name, 3, RSL, RSL, RS)
#define BaseREG2(opcode, name) BaseREG(opcode, name, 2, RSL, RS, UnusedField)
#define BaseREG0(opcode, name) BaseREG(opcode, name, 0, UnusedField, UnusedField, UnusedField)
BaseREG3(0x580, notbit)
BaseREG3(0x581, and)
BaseREG3(0x582, andnot)
BaseREG3(0x583, setbit)
BaseREG3(0x584, notand)
BaseREG3(0x586, xor)
BaseREG3(0x587, or)
BaseREG3(0x588, nor)
BaseREG3(0x589, xnor)
BaseREG2(0x58a, not)
BaseREG3(0x58b, ornot)
BaseREG3(0x58c, clrbit)
BaseREG3(0x58d, notor)
BaseREG3(0x58e, nand)
BaseREG3(0x58f, alterbit)
BaseREG3(0x590, addo)
BaseREG3(0x591, addi)
BaseREG3(0x592, subo)
BaseREG3(0x593, subi)
BaseREG3(0x598, shro)
BaseREG3(0x59a, shrdi)
BaseREG3(0x59b, shri)
BaseREG3(0x59c, shlo)
BaseREG3(0x59d, rotate)
BaseREG3(0x59e, shli)
BaseREG2(0x5a0, cmpo)
BaseREG2(0x5a1, cmpi)
BaseREG2(0x5a2, concmpo)
BaseREG2(0x5a3, concmpi)
BaseREG3(0x5a4, cmpinco)
BaseREG3(0x5a5, cmpinci)
BaseREG3(0x5a6, cmpdeco)
BaseREG3(0x5a7, cmpdeci)
BaseREG2(0x5ac, scanbyte)
BaseREG2(0x5ae, chkbit)
BaseREG3(0x5b0, addc)
BaseREG3(0x5b2, subc)
BaseREG(0x5cc, mov, 2, RSL, RS, UnusedField)
BaseREG(0x5dc, movl, 2, RL2, R2, UnusedField)
BaseREG(0x5ec, movt, 2, RL4, R4, UnusedField)
BaseREG(0x5fc, movq, 2, RL4, R4, UnusedField)
BaseREG(0x610, atmod, 3, RS, RSL, R)
BaseREG(0x612, atadd, 3, RS, RSL, RS)
BaseREG2(0x640, spanbit)
BaseREG2(0x641, scanbit)
// Decimal instructions are part of the numerics architecture level but are not
// the same as the other numerics operations relating to floating point
// operations
BaseREG3(0x645, modac)
BaseREG(0x650, modify, 3, RSL, RSL, R)
BaseREG(0x651, extract, 3, RSL, RSL, R)
BaseREG3(0x654, modtc)
BaseREG(0x655, modpc, 3, RSL, RSL, R)

BaseREG(0x660, calls, 1, RSL, UnusedField, UnusedField)
BaseREG0(0x66b, mark)
BaseREG0(0x66c, fmark)
BaseREG0(0x66d, flushreg)
BaseREG0(0x66f, syncf)

BaseREG(0x670, emul, 3, RSL, RSL, R2)
BaseREG(0x671, ediv, 3, RSL, RL2, RS)

BaseREG3(0x701, mulo)
BaseREG3(0x708, remo)
BaseREG3(0x70b, divo)
BaseREG3(0x741, muli)
BaseREG3(0x748, remi)
BaseREG3(0x749, modi)
BaseREG3(0x74b, divi)

#define DecimalREG(opcode, name, count, src1, src2, srcDest) CoreREG(opcode, name, Decimal, count, src1, src2, srcDest)
DecimalREG(0x642, daddc, 3, RSL, RSL, RS)
DecimalREG(0x643, dsubc, 3, RSL, RSL, RS)
DecimalREG(0x644, dmovt, 2, RSL, RS, UnusedField)
#undef DecimalREG
#define KxOperation(opcode, name) CoreREG(opcode, name, Kx, 2, R, R, UnusedField)
KxOperation(0x600, synmov)
KxOperation(0x601, synmovl)
KxOperation(0x602, synmovq)
KxOperation(0x615, synld)
#undef KxOperation

#define FloatingPointREG(opcode, name, count, src1, src2, srcDest) CoreREG(opcode, name, FloatingPoint, count, src1, src2, srcDest)
#define FloatingPointREG3(opcode, name, src1, src2, srcDest) FloatingPointREG(opcode, name, 3, src1, src2, srcDest)
#define FloatingPointREG2(opcode, name, src1, src2) FloatingPointREG(opcode, name, 2, src1, src2, UnusedField)
#define FloatingPointREG1(opcode, name, src1) FloatingPointREG(opcode, name, 1, src1, UnusedField, UnusedField)
#define FloatingPointREG0(opcode, name) FloatingPointREG(opcode, name, 0, UnusedField, UnusedField, UnusedField)
FloatingPointREG2(0x674, cvtir, RL, F)
FloatingPointREG2(0x675, cvtilr, RL2, F)
FloatingPointREG3(0x676, scalerl, RL, FL2, F2)
FloatingPointREG3(0x677, scaler, RL, FL, F)
#define Q(opcode, name) FloatingPointREG3(opcode, name, FL, FL, F)
Q(0x680, atanr)
Q(0x681, logepr)
Q(0x682, logr)
Q(0x683, remr)
Q(0x78b, divr)
Q(0x78c, mulr)
Q(0x78d, subr)
Q(0x78e, addr)
#undef Q
#define Q(opcode, name) FloatingPointREG2(opcode, name, FL, FL)
Q(0x684, cmpor)
Q(0x685, cmpr)
#undef Q
#define Q(opcode, name) FloatingPointREG2(opcode, name, FL, F)
Q(0x688, stqtr)
Q(0x689, expr)
Q(0x68a, logbnr)
Q(0x68b, roundr)
Q(0x68c, sinr)
Q(0x68d, cosr)
Q(0x68e, tanr)
#undef Q
